{
  "name": "knowledge-graph-search",
  "version": "1.0.0",
  "description": "Search engine for GOV.UK content",
  "main": "src/backend/server.ts",
  "scripts": {
    "start": "node dist/backend/server.js",
    "dev": "npm run copy-assets && nodemon src/backend/server.ts --ignore src/frontend",
    "local": "env $(cat .env-signon-mock|xargs) npm run start",
    "clean-build": "rm -rf dist public && npm run build",
    "build": "npm run copy-assets && npm run build-frontend && npm run build-app",
    "postbuild": "mv dist/src/* dist/ && cp -r src/backend/views dist/backend/views",
    "build-app": "tsc",
    "build-frontend": "webpack",
    "copy-assets": "sh scripts/install-govuk-frontend.sh && sh scripts/install-accessible-autocomplete.sh",
    "test": "jest --watchAll --coverage --verbose --detectOpenHandles",
    "test-ci": "jest --coverage --coverageReporters=json --verbose --detectOpenHandles --colors",
    "lint": "eslint . --fix",
    "check-lint": "eslint .",
    "format": "prettier --write '.'",
    "check-format": "prettier --check '.'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphagov/knowledge-graph-search.git"
  },
  "nodemonConfig": {
    "ext": "ts,js,json,njk,html"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/alphagov/knowledge-graph-search/issues"
  },
  "homepage": "https://github.com/alphagov/knowledge-graph-search#readme",
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@relaycorp/pino-cloud": "^1.0.28",
    "@types/express": "^4.17.14",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^18.11.14",
    "accessible-autocomplete": "^2.0.4",
    "axios": "^1.21.0",
    "ci": "^2.3.0",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-stringify": "^6.2.4",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.18.2",
    "google-libphonenumber": "^3.2.48",
    "got": "^16.1.0",
    "govuk-frontend": "^5.14.0",
    "ioredis": "^5.3.2",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.7.0",
    "pino": "^8.14.1",
    "pino-http": "^8.3.3",
    "pino-http-print": "^3.1.0",
    "pino-pretty": "^10.0.0",
    "source-map-support": "^0.5.21",
    "webpack": "^5.112.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/dotenv": "^8.2.3",
    "@types/express-session": "^1.17.7",
    "@types/jest": "^29.5.2",
    "@types/nunjucks": "^3.2.2",
    "@types/passport-oauth2": "^1.4.12",
    "@types/supertest": "^2.0.12",
    "@types/webpack-hot-middleware": "^2.25.6",
    "css-loader": "^7.1.5",
    "cypress": "^15.16.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-jest": "^29.17.0",
    "file-loader": "^6.2.0",
    "globals": "^17.14.0",
    "ignore-webpack-plugin": "^0.3.0",
    "jest": "^29.5.0",
    "localforage": "^1.10.0",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^3.1.7",
    "prettier": "^2.8.8",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.107.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.72.1",
    "url-loader": "^4.1.1",
    "webpack-cli": "^7.3.1",
    "webpack-dev-middleware": "^8.6.0",
    "webpack-hot-middleware": "^2.25.4"
  }
}
